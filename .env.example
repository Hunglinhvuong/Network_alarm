# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit .env vào git.

# ---------- Timezone ----------
# Múi giờ cho toàn bộ hệ thống (DB session, logging, alert messages)
# Mặc định: Asia/Ho_Chi_Minh
APP_TIMEZONE=Asia/Ho_Chi_Minh

# ---------- PostgreSQL ----------
PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=network_alarm
PG_USER=postgres
PG_PASSWORD=postgres

# ---------- Nguồn alarm ----------
# "csv" (test) | "oracle" (thật)
ALARM_SOURCE=csv
ALARM_CSV_PATH=sample_data/alarms.csv

ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SERVICE=
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_ALARM_TABLE=ALARM_ACTIVE
ORACLE_CONNECT_TIMEOUT_SEC=5
ORACLE_CALL_TIMEOUT_MS=10000

# ---------- Polling ----------
POLL_INTERVAL_NORMAL_SEC=300
POLL_INTERVAL_ACTIVE_SEC=60
PERIODIC_REPORT_INTERVAL_MINUTES=1440
PERIODIC_REPORT_START_TIME=08:00

# ---------- RCA (tham số hoá, chưa có bảng config trong DB) ----------
NODE_SYNC_WINDOW_MINUTES=10
POWER_FAIL_LOOKBACK_HOURS=12
POWER_FAIL_CORRELATION_HOURS=6
NEIGHBOR_DISTANCE_KM=7.0

# ---------- Telegram ----------
# Token lấy từ @BotFather
TELEGRAM_BOT_TOKEN=

# Chat ID nhận cảnh báo tự động — có thể nhiều, cách nhau bởi dấu phẩy.
# Group: thêm bot vào group -> lấy chat_id âm (vd: -1001234567890)
TELEGRAM_ALERT_CHAT_IDS=
TELEGRAM_OUTBOX_POLL_INTERVAL_SEC=1
TELEGRAM_SEND_INTERVAL_SEC=1
TELEGRAM_GROUP_SEND_INTERVAL_SEC=3
TELEGRAM_GLOBAL_SEND_INTERVAL_SEC=0.05

# User_id Telegram được phép dùng lệnh tra cứu/quản trị (whitelist), cách nhau bởi dấu phẩy.
# Để trống = cho phép tất cả (KHÔNG khuyến khích ở production).
TELEGRAM_ADMIN_IDS=

TELEGRAM_BOT_POLL_INTERVAL_SEC=2

# ---------- Logging ----------
LOG_LEVEL=INFO
